{
  "name": "everyrow-excel",
  "version": "1.0.0",
  "description": "EveryRow SDK Excel Add-in - Screen, rank, dedupe, and merge your spreadsheets using natural language",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build && cp -r assets dist/ && cp manifest.production.xml dist/manifest.xml",
    "preview": "vite preview",
    "start": "vite",
    "certs": "office-addin-dev-certs install",
    "certs:verify": "office-addin-dev-certs verify",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "everyrow",
    "excel",
    "add-in",
    "office",
    "ai",
    "data"
  ],
  "author": "FutureSearch",
  "license": "MIT",
  "homepage": "https://everyrow.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/futuresearch/everyrow-excel"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@fluentui/react-components": "^9.72.10",
    "@fluentui/react-icons": "^2.0.317",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.10",
    "@types/office-js": "^1.0.569",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^28.0.0",
    "office-addin-dev-certs": "^2.0.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
